{
  "name": "media-native",
  "version": "0.0.1",
  "description": "React Native wrapper for media-core",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "media-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-native": ">=0.73.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5"
  }
}