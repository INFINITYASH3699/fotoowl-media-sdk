{
  "name": "media-core",
  "version": "0.0.1",
  "description": "Framework-agnostic Pexels media SDK core",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
